@model IEnumerable<DersTakipSistemiProje.Models.Der>
@{
    ViewData["Title"] = "Ders Listesi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Ders Kataloğu</h2>
        <a href="/Yonetici/DersEkle" class="btn btn-success">+ Yeni Ders Ekle</a>
    </div>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Ders Kodu</th>
                <th>Ders Adı</th>
                <th>Kredi</th>
                <th>Bölüm</th>
                <th>İşlem</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ders in Model)
            {
                <tr>
                    <td>@ders.DersKod</td>
                    <td>@ders.DersAd</td>
                    <td>@ders.Kredi</td>
                    <td>@(ders.Bolum != null ? ders.Bolum.BolumAd : "-")</td>
                    <td>
                        <a href="/Yonetici/DersSil?id=@ders.DersKod" class="btn btn-danger btn-sm" onclick="return confirm('Silmek istediğine emin misin?')">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <a href="/Home/Index" class="btn btn-secondary">← Ana Sayfa</a>
</div>