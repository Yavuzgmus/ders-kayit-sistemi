@model List<DersTakipSistemiProje.Models.Ogrenci>
@{
    ViewData["Title"] = "Öğrenci Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Öğrenci Listesi</h3>
        <a href="/Yonetici/OgrenciEkle" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Yeni Öğrenci Ekle
        </a>
    </div>

    @if (TempData["Mesaj"] != null)
    {
        <div class="alert alert-success">@TempData["Mesaj"]</div>
    }

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>No</th>
                <th>Ad Soyad</th>
                <th>Bölüm</th>
                <th>Sınıf</th>
                <th>E-Posta</th>
                <th style="width: 180px;">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.OgrenciId</td>
                    <td>@item.Ad @item.Soyad</td>
                    <td>@(item.Bolum != null ? item.Bolum.BolumAd : "-")</td>
                    <td>@item.Sinif</td>
                    <td>@item.EPosta</td>
                    <td>
                        <a href="/Yonetici/OgrenciDuzenle/@item.OgrenciId" class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil"></i> Düzenle
                        </a>

                        <a href="/Yonetici/OgrenciSil/@item.OgrenciId" class="btn btn-danger btn-sm" onclick="return confirm('Silmek istiyor musunuz?');">
                            <i class="bi bi-trash"></i> Sil
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>