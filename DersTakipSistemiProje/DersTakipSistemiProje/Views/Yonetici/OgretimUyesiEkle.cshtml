@model DersTakipSistemiProje.Models.OgretimUyesi
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Öğretim Üyesi Ekle</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="card shadow col-md-6 mx-auto">
            <div class="card-header bg-warning"><h4>Yeni Akademisyen Kaydı</h4></div>
            <div class="card-body">

                @if (ViewBag.Hata != null)
                {
                    <div class="alert alert-danger">@ViewBag.Hata</div>
                }

                <form action="/Yonetici/OgretimUyesiEkle" method="post">

                    <div class="mb-3">
                        <label class="form-label">Sicil Numarası (Kullanıcı Adı)</label>
                        <input type="number" name="OgretimUyesiId" class="form-control" required placeholder="Örn: 105" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Unvan</label>
                        <select name="Unvan" class="form-select">
                            <option value="Dr. Öğr. Üyesi">Dr. Öğr. Üyesi</option>
                            <option value="Doç. Dr.">Doç. Dr.</option>
                            <option value="Prof. Dr.">Prof. Dr.</option>
                            <option value="Arş. Gör.">Arş. Gör.</option>
                            <option value="Öğr. Gör.">Öğr. Gör.</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Ad</label>
                        <input type="text" name="Ad" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Soyad</label>
                        <input type="text" name="Soyad" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Bölüm</label>
                        <select name="BolumId" class="form-select" required>
                            <option value="">Seçiniz...</option>
                            @if (ViewBag.Bolumler != null)
                            {
                                foreach (var bolum in (List<DersTakipSistemiProje.Models.Bolum>)ViewBag.Bolumler)
                                {
                                    <option value="@bolum.BolumId">@bolum.BolumAd</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Şifre</label>
                        <input type="text" name="Sifre" class="form-control" value="123" required />
                    </div>

                    <button type="submit" class="btn btn-warning w-100">Kaydet</button>
                    <a href="/Yonetici/OgretimUyesiListesi" class="btn btn-secondary w-100 mt-2">İptal</a>
                </form>
            </div>
        </div>
    </div>
</body>
</html>