@model DersTakipSistemiProje.Models.Ogrenci
@{
    ViewData["Title"] = "Öğrenci Düzenle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3><i class="bi bi-person-gear"></i> Öğrenci Bilgilerini Düzenle</h3>
        <a href="/Yonetici/OgrenciListesi" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Listeye Dön
        </a>
    </div>

    @if (TempData["Mesaj"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill"></i> @TempData["Mesaj"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="m-0">#@Model.OgrenciId - @Model.Ad @Model.Soyad</h5>
        </div>
        <div class="card-body">

            <form asp-action="OgrenciDuzenle" method="post">
                <input type="hidden" asp-for="OgrenciId" />

                <h6 class="text-primary border-bottom pb-2 mb-3">Akademik Bilgiler</h6>
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Ad</label>
                        <input type="text" asp-for="Ad" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Soyad</label>
                        <input type="text" asp-for="Soyad" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Sınıf</label>
                        <input type="number" asp-for="Sinif" class="form-control" min="1" max="4" required />
                    </div>
                </div>

                <h6 class="text-primary border-bottom pb-2 mb-3 mt-4">İletişim Bilgileri</h6>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold"><i class="bi bi-envelope"></i> E-Posta</label>
                        <input type="email" asp-for="EPosta" class="form-control" placeholder="ornek@mail.com" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold"><i class="bi bi-telephone"></i> Telefon</label>
                        <input type="text" asp-for="Telefon" class="form-control" placeholder="0555 555 55 55" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold"><i class="bi bi-geo-alt"></i> Adres</label>
                    <textarea asp-for="Adres" class="form-control" rows="3" placeholder="Açık adres giriniz..."></textarea>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="bi bi-save"></i> Değişiklikleri Kaydet
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>