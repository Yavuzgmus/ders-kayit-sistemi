@model DersTakipSistemiProje.Models.Der
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Ders Ekle</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="card shadow col-md-6 mx-auto">
            <div class="card-header bg-danger text-white"><h4>Yeni Ders Tanımla</h4></div>
            <div class="card-body">
                <form action="/Yonetici/DersEkle" method="post">

                    <div class="mb-3">
                        <label class="form-label">Ders Kodu</label>
                        <input type="text" name="DersKod" class="form-control" required placeholder="Örn: MAT101" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ders Adı</label>
                        <input type="text" name="DersAd" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Kredi</label>
                        <input type="number" name="Kredi" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Bölüm</label>
                        <select name="BolumId" class="form-select" required>
                            <option value="">Seçiniz...</option>
                            @if (ViewBag.Bolumler != null)
                            {
                                foreach (var bolum in (List<DersTakipSistemiProje.Models.Bolum>)ViewBag.Bolumler)
                                {
                                    <option value="@bolum.BolumId">@bolum.BolumAd</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Dersi Verecek Hoca</label>
                        <select name="OgretimUyesiId" class="form-select" required>
                            <option value="">Hoca Seçiniz...</option>
                            @if (ViewBag.Hocalar != null)
                            {
                                foreach (var hoca in (List<DersTakipSistemiProje.Models.OgretimUyesi>)ViewBag.Hocalar)
                                {
                                    <option value="@hoca.OgretimUyesiId">@hoca.Unvan @hoca.Ad @hoca.Soyad</option>
                                }
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-danger w-100">Kaydet</button>
                    <a href="/Yonetici/DersListesi" class="btn btn-secondary w-100 mt-2">İptal</a>
                </form>
            </div>
        </div>
    </div>
</body>
</html>