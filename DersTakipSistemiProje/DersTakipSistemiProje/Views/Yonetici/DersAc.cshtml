@model DersTakipSistemiProje.Models.DersDetay
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Ders Aç (Şube Tanımla)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-header bg-success text-white"><h4>Dönem Dersi Aç</h4></div>
                    <div class="card-body">

                        @if (TempData["Mesaj"] != null)
                        {
                            <div class="alert alert-info">@TempData["Mesaj"]</div>
                        }

                        <form action="/Yonetici/DersAc" method="post">

                            @if (ViewBag.Hata != null)
                            {
                                <div class="alert alert-danger">@ViewBag.Hata</div>
                            }

                            <div class="mb-3">
                                <label class="form-label">Açılacak Ders</label>
                                <select name="DersKod" class="form-select" required>
                                    <option value="">Ders Seçiniz...</option>
                                    @if (ViewBag.Dersler != null)
                                    {
                                        foreach (var ders in (List<DersTakipSistemiProje.Models.Der>)ViewBag.Dersler)
                                        {
                                            <option value="@ders.DersKod">@ders.DersAd (@ders.DersKod)</option>
                                        }
                                    }
                                </select>
                                <small class="text-muted">Not: Dersin hocası otomatik atanacaktır.</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Dönem</label>
                                <select name="DonemId" class="form-select" required>
                                    @if (ViewBag.Donemler != null)
                                    {
                                        foreach (var donem in (List<DersTakipSistemiProje.Models.Donem>)ViewBag.Donemler)
                                        {
                                            <option value="@donem.DonemId">@donem.Yil - @donem.Yariyil</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Kontenjan</label>
                                <input type="number" name="Kontenjan" class="form-control" value="50" required />
                            </div>

                            <button type="submit" class="btn btn-success w-100">Dersi Aç</button>
                            <br /><br />
                            <a href="/Home/Index" class="btn btn-secondary w-100">Ana Sayfaya Dön</a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>