@model IEnumerable<DersTakipSistemiProje.Models.DersDetay>
@{
    ViewData["Title"] = "Verilen Dersler";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="mb-4 text-primary"><i class="bi bi-person-video3"></i> Verdiğim Dersler</h2>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Ders Kodu</th>
                        <th>Ders Adı</th>
                        <th>Kredi</th>
                        <th>Kontenjan</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@item.DersKod</td>
                                <td>@item.DersKodNavigation.DersAd</td>
                                <td>@item.DersKodNavigation.Kredi</td>
                                <td>@item.Kontenjan</td>
                                <td class="text-center">
                                    <a href="/OgretimUyesi/NotGiris/@item.DersDetayId" class="btn btn-primary btn-sm px-4">
                                        <i class="bi bi-pencil-square me-2"></i> Not Gir
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-folder-x fs-1 d-block mb-3"></i>
                                Henüz üzerinize atanmış bir ders bulunmamaktadır.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>