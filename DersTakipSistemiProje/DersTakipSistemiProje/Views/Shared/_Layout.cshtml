<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ders Kayıt Sistemi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-light border-bottom mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" href="/Home/Index">Ders Kayıt Sistemi</a>

                <div class="d-flex">
                    @try
                    {
                        @using Microsoft.AspNetCore.Http
                                            @inject IHttpContextAccessor HttpContextAccessor

                                            var session = HttpContextAccessor.HttpContext?.Session;
                        string adSoyad = null;

                        if (session != null)
                        {
                            if (session.IsAvailable)
                            {
                                adSoyad = session.GetString("AdSoyad");
                            }
                        }

                        if (!string.IsNullOrEmpty(adSoyad))
                        {
                            <span class="navbar-text me-3 fw-bold">@adSoyad</span>
                            <a href="/Account/Logout" class="btn btn-outline-danger btn-sm">Çıkış Yap</a>
                        }
                    }
                    catch
                    {
                        <span class="text-danger small">Oturum Hatası</span>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>