@model IEnumerable<DersTakipSistemiProje.Models.Notlar>
@{
    ViewData["Title"] = "Transkript";
}

<div class="container mt-4">
    <div class="card shadow-sm mb-4 border-primary">
        <div class="card-body d-flex justify-content-between align-items-center bg-light">
            <div>
                <h2 class="mb-0 text-primary">Transkript</h2>
                <small class="text-muted">Akademik not dökümü ve başarı durumu</small>
            </div>
            <div class="text-center p-3 bg-white rounded shadow-sm border">
                <h6 class="text-secondary mb-1">Genel Ortalama (GANO)</h6>
                <h1 class="display-6 fw-bold text-success mb-0">@ViewBag.Gano</h1>
            </div>
        </div>
    </div>

    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Ders Kodu</th>
                <th>Ders Adı</th>
                <th>Dönem</th>
                <th>Kredi</th>
                <th>Vize</th>
                <th>Final</th>
                <th>Ortalama</th>
                <th>Harf Notu</th>
                <th>Durum</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                double ort = (double)((item.Vize * 0.4m) + (item.Final * 0.6m));
                bool gecti = item.HarfNotu != "FF" && item.HarfNotu != "FD" && item.HarfNotu != "NA";

                <tr>
                    <td>@item.DersDetay.DersKodNavigation.DersKod</td>
                    <td>@item.DersDetay.DersKodNavigation.DersAd</td>
                    <td>@item.DersDetay.Donem.Yil @item.DersDetay.Donem.Yariyil</td>
                    <td>@item.DersDetay.DersKodNavigation.Kredi</td>
                    <td>@((int)item.Vize)</td>
                    <td>@((int)item.Final)</td>
                    <td class="fw-bold">@ort.ToString("0.0")</td>

                    <td class="text-center">
                        @if (item.HarfNotu == "NA")
                        {
                            <span class="badge bg-secondary">Girilmedi</span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark">@item.HarfNotu</span>
                        }
                    </td>

                    <td class="text-center">
                        @if (item.HarfNotu == "NA")
                        {
                            <span>-</span>
                        }
                        else if (gecti)
                        {
                            <span class="text-success fw-bold">✓ Geçti</span>
                        }
                        else
                        {
                            <span class="text-danger fw-bold">✕ Kaldı</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-4">
        <a href="/Home/Index" class="btn btn-secondary">← Ana Sayfa</a>
    </div>
</div>